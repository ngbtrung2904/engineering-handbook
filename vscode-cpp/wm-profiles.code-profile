{"name":"wm-profiles","icon":"star-empty","settings":"{\"settings\":\"{\\n    \\\"workbench.colorTheme\\\": \\\"Dark+\\\",\\n    // Set the font\\n    \\\"editor.fontFamily\\\": \\\"'JetBrains Mono', Consolas, 'Courier New', monospace\\\",\\n    // Set the font size\\n    \\\"editor.fontSize\\\": 13,\\n    // Turn on font ligatures\\n    \\\"editor.fontLigatures\\\": true,\\n    // Set letter spacing\\n    \\\"editor.letterSpacing\\\": 0.4,\\n    // Enable smooth scrolling in the editor\\n    \\\"editor.smoothScrolling\\\": true,\\n    // Set font to terminal\\n    \\\"terminal.integrated.fontFamily\\\": \\\"'JetBrains Mono'\\\",\\n    \\\"hediet.vscode-drawio.resizeImages\\\": null,\\n    // Markdown file setting\\n    \\\"markdown.preview.fontFamily\\\": \\\"'JetBrains Mono', Consolas, 'Courier New', monospace\\\",\\n    \\\"chat.viewSessions.orientation\\\": \\\"stacked\\\",\\n    \\\"clangd.detectExtensionConflicts\\\": false,\\n    \\\"workbench.editorAssociations\\\": {\\n        \\\"*.copilotmd\\\": \\\"vscode.markdown.preview.editor\\\",\\n        \\\"{git,gitlens,chat-editing-snapshot-text-model,copilot,git-graph,git-graph-3}:/**/*.qrc\\\": \\\"default\\\",\\n        \\\"*.qrc\\\": \\\"qt-core.qrcEditor\\\"\\n    },\\n    \\\"workbench.iconTheme\\\": \\\"vscode-icons\\\",\\n    \\\"cmake.showConfigureWithDebuggerNotification\\\": false,\\n    \\\"gitlens.graph.details.location\\\": \\\"auto\\\",\\n    \\\"files.autoSave\\\": \\\"afterDelay\\\",\\n    \\\"terminal.integrated.profiles.linux\\\": {\\n        \\\"bash\\\": {\\n            \\\"path\\\": \\\"bash\\\",\\n            \\\"icon\\\": \\\"terminal-bash\\\"\\n        },\\n        \\\"zsh\\\": {\\n            \\\"path\\\": \\\"zsh\\\"\\n        },\\n        \\\"fish\\\": {\\n            \\\"path\\\": \\\"fish\\\"\\n        },\\n        \\\"tmux\\\": {\\n            \\\"path\\\": \\\"tmux\\\",\\n            \\\"icon\\\": \\\"terminal-tmux\\\"\\n        },\\n        \\\"pwsh\\\": {\\n            \\\"path\\