{
    "version": "0.2.0",
    // The Qt "qt vsCode tools" extension can attach a debugger visualizer
    // (qt.natvis.xml) for pretty-printing Qt types in the watch window. The
    // path is user-specific, so it is intentionally not committed here. To
    // enable it, run "Qt: Copy Qt Visualizer File Path" from the command
    // palette and add the returned path as a "visualizerFile" property on
    // the desired debug configuration.
    "configurations": [
        {
            "name": "Qt C++: Debug (GCC)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/Desktop_Qt_6_7_2-Debug/app/apparddm",
            "preLaunchTask": "Build (GCC)",
            "envFile": "${workspaceFolder}/.vscode/ros2.env",
            "args": [
                "--u",
                "--fnc=0"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "setupCommands": [
                {
                    "description": "Enable GDB pretty-printing",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "visualizerFile": "/home/trungnb/.config/Code/User/workspaceStorage/6dc496015b052eaf8e5831d215f6a9dc/tonka3000.qtvsctools/qt.natvis.xml"
        },
        {
            "name": "Qt C++: Debug (Clang)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/Desktop_Qt_6_7_2-Debug/app/apparddm",
            "preLaunchTask": "Build (Clang+Mold)",
            "envFile": "${workspaceFolder}/.vscode/ros2.env",
            "args": [
                "--u",
                "--fnc=0"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "setupCommands": [
                {
                    "description": "Enable GDB pretty-printing",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "visualizerFile": "/home/trungnb/.config/Code/User/workspaceStorage/6dc496015b052eaf8e5831d215f6a9dc/tonka3000.qtvsctools/qt.natvis.xml"
        }
    ]
}